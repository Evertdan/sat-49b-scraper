#!/usr/bin/env php
<?php

declare(strict_types=1);

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (file_exists($autoload)) {
        require $autoload;
        break;
    }
}

use PhpCfdi\Sat49BScraper\Scraper;

$fecha = new DateTimeImmutable($argv[1] ?? 'today');
$edicion = $argv[2] ?? 'MAT';

$companies = Scraper::create()->scrape($fecha, $edicion);

echo json_encode($companies, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE), PHP_EOL;
